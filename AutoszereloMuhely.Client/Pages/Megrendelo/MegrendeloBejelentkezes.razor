@* Megrendelői felület - Ügyfélszám megadása a munkák megtekintéséhez *@
@page "/megrendelo"
@inject NavigationManager Navigation

<h3>Megrendelői felület</h3>
<p>Adja meg az ügyfélszámát a munkái megtekintéséhez:</p>

<div>
    <label>Ügyfélszám:</label>
    <input type="text" @bind="ugyfelId" />
    <button @onclick="Kereses">Keresés</button>
</div>

@code {
    private string ugyfelId = string.Empty;

    // Átirányítás a munkák oldalra az ügyfélszámmal
    private void Kereses()
    {
        Navigation.NavigateTo($"/megrendelo/munkak/{ugyfelId}");
    }
}