@* Megrendelői felület - nyitóoldal *@
@page "/megrendelo"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthService AuthService

<PageTitle>Megrendelői felület</PageTitle>

<h3>Megrendelői felület</h3>

<AuthorizeView Roles="Felhasznalo" Context="authCtx">
    <Authorized>
        @* Bejelentkezett felhasználó - saját munkák és új rendelés *@
        <p>Üdvözöljük, <strong>@authCtx.User.Identity?.Name</strong>!</p>

        <div class="d-flex gap-3 mb-4">
            <button class="btn btn-primary" @onclick="NezMunkak">Megrendeléseim</button>
            <button class="btn btn-success" @onclick="NezUjMunka">Új megrendelés leadása</button>
        </div>

        @if (nezet == "munkak")
        {
            @if (munkak == null)
            {
                <p>Betöltés...</p>
            }
            else if (munkak.Count == 0)
            {
                <p>Jelenleg nincs aktív megrendelése.</p>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>Rendszám</th>
                            <th>Kategória</th>
                            <th>Hiba leírása</th>
                            <th>Súlyosság</th>
                            <th>Állapot</th>
                            <th>Esztimáció (óra)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in munkak)
                        {
                            <tr>
                                <td>@m.Rendszam</td>
                                <td>@m.Kategoria</td>
                                <td>@m.HibaLeiras</td>
                                <td>@m.HibaSulyossag</td>
                                <td>@m.Allapot</td>
                                <td>@m.MunkaoraEsztimacio.ToString("F1")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }

        @if (nezet == "ujmunka")
        {
            <h4>Új megrendelés</h4>
            @if (!string.IsNullOrEmpty(sikerUzenet))
            {
                <div class="alert alert-success">@sikerUzenet</div>
            }
            <EditForm Model="@ujMunka" OnValidSubmit="BejelentkezettMegrendeles">
                <DataAnnotationsValidator />
                <ValidationSummary />
                <div class="mb-2">
                    <label class="form-label">Rendszám (XXX-YYY):</label>
                    <InputText class="form-control" @bind-Value="ujMunka.Rendszam" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Gyártási év:</label>
                    <InputNumber class="form-control" @bind-Value="ujMunka.GyartasiEv" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Kategória:</label>
                    <InputSelect class="form-select" @bind-Value="ujMunka.Kategoria">
                        <option value="">-- Válasszon --</option>
                        <option value="Karosszeria">Karosszéria</option>
                        <option value="Motor">Motor</option>
                        <option value="Futomu">Futómű</option>
                        <option value="Fekberendezes">Fékberendezés</option>
                    </InputSelect>
                </div>
                <div class="mb-2">
                    <label class="form-label">Hiba leírása:</label>
                    <InputText class="form-control" @bind-Value="ujMunka.HibaLeiras" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Súlyosság (1-10):</label>
                    <InputNumber class="form-control" @bind-Value="ujMunka.HibaSulyossag" />
                </div>
                <button type="submit" class="btn btn-success">Megrendelés leadása</button>
            </EditForm>
        }
    </Authorized>
</AuthorizeView>

<AuthorizeView Context="anonCtx">
    <NotAuthorized>
        @* Nem bejelentkezett - anonim megrendelés vagy bejelentkezés *@
        <div class="mb-3">
            <p>
                Rendelését bejelentkezés nélkül is leadhatja, de
                <a href="/bejelentkezes">bejelentkezve</a> vagy
                <a href="/regisztracio">regisztrálva</a> nyomon követheti megrendeléseit.
            </p>
        </div>

        @if (!anonSiker)
        {
            <h4>Megrendelés leadása (regisztráció nélkül)</h4>
            @if (!string.IsNullOrEmpty(anonHiba))
            {
                <div class="alert alert-danger">@anonHiba</div>
            }
            <EditForm Model="@anonModel" OnValidSubmit="AnonMegrendeles">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <h5 class="mt-3">Személyes adatok</h5>
                <div class="mb-2">
                    <label class="form-label">Teljes név:</label>
                    <InputText class="form-control" @bind-Value="anonModel.Nev" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Email cím (megrendelés azonosítóhoz):</label>
                    <InputText class="form-control" @bind-Value="anonModel.Email" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Lakcím:</label>
                    <InputText class="form-control" @bind-Value="anonModel.Lakcim" />
                </div>

                <h5 class="mt-3">Jármű és hiba adatok</h5>
                <div class="mb-2">
                    <label class="form-label">Rendszám (XXX-YYY):</label>
                    <InputText class="form-control" @bind-Value="anonModel.Rendszam" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Gyártási év:</label>
                    <InputNumber class="form-control" @bind-Value="anonModel.GyartasiEv" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Kategória:</label>
                    <InputSelect class="form-select" @bind-Value="anonModel.Kategoria">
                        <option value="">-- Válasszon --</option>
                        <option value="Karosszeria">Karosszéria</option>
                        <option value="Motor">Motor</option>
                        <option value="Futomu">Futómű</option>
                        <option value="Fekberendezes">Fékberendezés</option>
                    </InputSelect>
                </div>
                <div class="mb-2">
                    <label class="form-label">Hiba leírása:</label>
                    <InputText class="form-control" @bind-Value="anonModel.HibaLeiras" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Súlyosság (1-10):</label>
                    <InputNumber class="form-control" @bind-Value="anonModel.HibaSulyossag" />
                </div>
                <button type="submit" class="btn btn-success">Megrendelés leadása</button>
            </EditForm>
        }
        else
        {
            <div class="alert alert-success">
                <h5>Megrendelés sikeresen leadva!</h5>
                <p>Köszönjük megrendelését! Az irodánk felveszi Önnel a kapcsolatot.</p>
                <a href="/regisztracio" class="btn btn-primary me-2">Regisztráljon a nyomon követéshez</a>
                <button class="btn btn-outline-secondary" @onclick="AnonSikerNullaz">Abból megrendelés</button>
            </div>
        }
    </NotAuthorized>
</AuthorizeView>

@code {
    // Bejelentkezett user nézet
    private string nezet = "munkak";
    private void NezMunkak() => nezet = "munkak";
    private void NezUjMunka() => nezet = "ujmunka";
    private void AnonSikerNullaz() => anonSiker = false;
    private List<MunkaDto>? munkak;
    private SajatMunkaDto ujMunka = new();
    private string? sikerUzenet;

    // Anonim nézet
    private AnonMegrendelesDto anonModel = new();
    private string? anonHiba;
    private bool anonSiker;

    protected override async Task OnInitializedAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user != null && user.Szerep == "Felhasznalo")
            await BetoltSajatMunkak();
    }

    private async Task BetoltSajatMunkak()
    {
        try
        {
            munkak = await Http.GetFromJsonAsync<List<MunkaDto>>("api/munkak/sajat");
        }
        catch
        {
            munkak = new List<MunkaDto>();
        }
    }

    private async Task BejelentkezettMegrendeles()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/munkak/sajat", ujMunka);
            if (response.IsSuccessStatusCode)
            {
                sikerUzenet = "Megrendelés sikeresen leadva!";
                ujMunka = new SajatMunkaDto();
                nezet = "munkak";
                await BetoltSajatMunkak();
            }
            else
            {
                sikerUzenet = null;
            }
        }
        catch
        {
            // Hiba esetén csendének marad - nem számlál jó hibakezelés
        }
    }

    private async Task AnonMegrendeles()
    {
        anonHiba = null;
        var response = await Http.PostAsJsonAsync("api/munkak/megrendeles", anonModel);
        if (response.IsSuccessStatusCode)
        {
            anonSiker = true;
            anonModel = new();
        }
        else
        {
            anonHiba = "Hiba a megrendelés leadásánál. Kérjük próbálja újra.";
        }
    }
}
