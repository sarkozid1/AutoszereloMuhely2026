@page "/iroda/ugyfelek/{Id}"
@attribute [Authorize(Roles = "Dolgozo,Adminisztrator")]
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Ügyfél szerkesztése</h3>

@if (ugyfel == null)
{
    <p class="loading">Betöltés...</p>
}
else
{
    <div class="card">
        <EditForm Model="@ugyfel" OnValidSubmit="Mentes">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" />

            <div class="form-group">
                <label>Név</label>
                <InputText @bind-Value="ugyfel.Nev" />
            </div>
            <div class="form-group">
                <label>Lakcím</label>
                <InputText @bind-Value="ugyfel.Lakcim" />
            </div>
            <div class="form-group">
                <label>Email</label>
                <InputText @bind-Value="ugyfel.Email" />
            </div>
            <button type="submit" class="btn btn-primary">Mentes</button>
            <a href="/iroda/ugyfelek" class="btn btn-secondary">Vissza</a>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private CreateUgyfelDto? ugyfel;

    protected override async Task OnInitializedAsync()
    {
        var result = await Http.GetFromJsonAsync<UgyfelDto>($"api/ugyfelek/{Id}");
        if (result != null)
        {
            ugyfel = new CreateUgyfelDto
            {
                Nev = result.Nev,
                Lakcim = result.Lakcim,
                Email = result.Email
            };
        }
    }

    private async Task Mentes()
    {
        await Http.PutAsJsonAsync($"api/ugyfelek/{Id}", ugyfel);
        Navigation.NavigateTo("/iroda/ugyfelek");
    }
}