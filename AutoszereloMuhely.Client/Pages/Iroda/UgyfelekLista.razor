@* Irodai felület - Ügyfelek listázása, hozzáadása, törlése *@
@page "/iroda/ugyfelek"
@attribute [Authorize(Roles = "Dolgozo,Adminisztrator")]
@inject HttpClient Http

<h3>Megrendelők</h3>

<div class="card">
    <h4>Új megrendelő</h4>
    <EditForm Model="@ujUgyfel" OnValidSubmit="Mentes">
        <DataAnnotationsValidator />
        <ValidationSummary class="validation-errors" />

        <div class="form-group">
            <label>Név</label>
            <InputText @bind-Value="ujUgyfel.Nev" />
            <ValidationMessage For="@(() => ujUgyfel.Nev)" />
        </div>
        <div class="form-group">
            <label>Lakcím</label>
            <InputText @bind-Value="ujUgyfel.Lakcim" />
            <ValidationMessage For="@(() => ujUgyfel.Lakcim)" />
        </div>
        <div class="form-group">
            <label>Email</label>
            <InputText @bind-Value="ujUgyfel.Email" />
            <ValidationMessage For="@(() => ujUgyfel.Email)" />
        </div>
        <button type="submit" class="btn btn-primary">Mentes</button>
    </EditForm>
</div>

<div class="card">
    <h4>Megrendelők listája</h4>

    @if (ugyfelek == null)
    {
        <p class="loading">Betöltes...</p>
    }
    else if (ugyfelek.Count == 0)
    {
        <p class="empty-state">Nincs megrendelő.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Név</th>
                    <th>Lakcím</th>
                    <th>Email</th>
                    <th>Műveletek</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in ugyfelek)
                {
                    <tr>
                        <td>@u.Nev</td>
                        <td>@u.Lakcim</td>
                        <td>@u.Email</td>
                        <td>
                            <a href="/iroda/ugyfelek/@u.Id" class="btn btn-secondary btn-sm">Szerkesztés</a>
                            <button class="btn btn-danger btn-sm" @onclick="() => Torles(u.Id)">Törles</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<UgyfelDto>? ugyfelek;
    private CreateUgyfelDto ujUgyfel = new();

    protected override async Task OnInitializedAsync()
    {
        await Betoltes();
    }

    private async Task Betoltes()
    {
        ugyfelek = await Http.GetFromJsonAsync<List<UgyfelDto>>("api/ugyfelek");
    }

    private async Task Mentes()
    {
        await Http.PostAsJsonAsync("api/ugyfelek", ujUgyfel);
        ujUgyfel = new();
        await Betoltes();
    }

    private async Task Torles(string id)
    {
        await Http.DeleteAsync($"api/ugyfelek/{id}");
        await Betoltes();
    }
}