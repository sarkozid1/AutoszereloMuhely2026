@page "/iroda/munkak/{Id}"
@inject HttpClient Http
@inject NavigationManager Navigation

<h3>Munka reszletei</h3>

@if (munka == null)
{
    <p class="loading">Betoltes...</p>
}
else
{
    <div class="card">
        <div class="detail-grid">
            <span class="detail-label">Rendszam:</span>
            <span class="detail-value">@munka.Rendszam</span>

            <span class="detail-label">Gyartasi ev:</span>
            <span class="detail-value">@munka.GyartasiEv</span>

            <span class="detail-label">Kategoria:</span>
            <span class="detail-value">@munka.Kategoria</span>

            <span class="detail-label">Hiba leirasa:</span>
            <span class="detail-value">@munka.HibaLeiras</span>

            <span class="detail-label">Sulyossag:</span>
            <span class="detail-value">@munka.HibaSulyossag / 10</span>

            <span class="detail-label">Allapot:</span>
            <span class="detail-value">
                <span class="badge @BadgeClass(munka.Allapot)">@AllapotNev(munka.Allapot)</span>
            </span>

            <span class="detail-label">Esztimacio:</span>
            <span class="detail-value esztimacio">@munka.MunkaoraEsztimacio.ToString("F1") ora</span>
        </div>
    </div>

    <div class="card">
        <h4>Szerkesztes</h4>
        <EditForm Model="@szerkesztes" OnValidSubmit="Mentes">
            <DataAnnotationsValidator />
            <ValidationSummary class="validation-errors" />

            <div class="form-group">
                <label>Rendszam</label>
                <InputText @bind-Value="szerkesztes.Rendszam" />
            </div>
            <div class="form-group">
                <label>Gyartasi ev</label>
                <InputNumber @bind-Value="szerkesztes.GyartasiEv" />
            </div>
            <div class="form-group">
                <label>Kategoria</label>
                <InputSelect @bind-Value="szerkesztes.Kategoria">
                    <option value="Karosszeria">Karosszeria</option>
                    <option value="Motor">Motor</option>
                    <option value="Futomu">Futomu</option>
                    <option value="Fekberendezes">Fekberendezes</option>
                </InputSelect>
            </div>
            <div class="form-group">
                <label>Hiba leirasa</label>
                <InputText @bind-Value="szerkesztes.HibaLeiras" />
            </div>
            <div class="form-group">
                <label>Sulyossag (1-10)</label>
                <InputNumber @bind-Value="szerkesztes.HibaSulyossag" />
            </div>
            <button type="submit" class="btn btn-primary">Mentes</button>
            <a href="/iroda/munkak" class="btn btn-secondary">Vissza</a>
        </EditForm>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private MunkaDto? munka;
    private UpdateMunkaDto szerkesztes = new();

    protected override async Task OnInitializedAsync()
    {
        munka = await Http.GetFromJsonAsync<MunkaDto>($"api/munkak/{Id}");
        if (munka != null)
        {
            szerkesztes = new UpdateMunkaDto
            {
                Rendszam = munka.Rendszam,
                GyartasiEv = munka.GyartasiEv,
                Kategoria = munka.Kategoria,
                HibaLeiras = munka.HibaLeiras,
                HibaSulyossag = munka.HibaSulyossag
            };
        }
    }

    private async Task Mentes()
    {
        await Http.PutAsJsonAsync($"api/munkak/{Id}", szerkesztes);
        munka = await Http.GetFromJsonAsync<MunkaDto>($"api/munkak/{Id}");
    }

    private string AllapotNev(string a) => a switch
    {
        "FelvettMunka" => "Felvett",
        "ElvegzesAlatt" => "Folyamatban",
        "Befejezett" => "Befejezett",
        _ => a
    };

    private string BadgeClass(string a) => a switch
    {
        "FelvettMunka" => "badge-felvett",
        "ElvegzesAlatt" => "badge-folyamatban",
        "Befejezett" => "badge-befejezett",
        _ => ""
    };
}