@page "/bejelentkezes"
@inject AuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<PageTitle>Bejelentkezés</PageTitle>

<div class="row justify-content-center mt-4">
    <div class="col-md-4">
        <h3>Bejelentkezés</h3>

        @if (!string.IsNullOrEmpty(hibaUzenet))
        {
            <div class="alert alert-danger">@hibaUzenet</div>
        }

        <EditForm Model="@model" OnValidSubmit="BejelentkezesKiserlet">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Felhasználónév:</label>
                <InputText class="form-control" @bind-Value="model.Felhasznalonev" />
            </div>
            <div class="mb-3">
                <label class="form-label">Jelszó:</label>
                <InputText class="form-control" type="password" @bind-Value="model.Jelszo" />
            </div>
            <button type="submit" class="btn btn-primary w-100" disabled="@betoltes">
                @(betoltes ? "Bejelentkezés..." : "Bejelentkezés")
            </button>
        </EditForm>

        <div class="mt-3 text-center">
            <a href="/regisztracio">Nincs még fiókja? Regisztráljon!</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private LoginDto model = new();
    private string? hibaUzenet;
    private bool betoltes;

    private async Task BejelentkezesKiserlet()
    {
        betoltes = true;
        hibaUzenet = null;

        var (success, error) = await AuthService.LoginAsync(model);

        if (success)
        {
            if (AuthStateProvider is CustomAuthStateProvider provider)
                provider.NotifyAuthStateChanged();

            Navigation.NavigateTo(ReturnUrl ?? "/");
        }
        else
        {
            hibaUzenet = error ?? "Bejelentkezés sikertelen.";
        }

        betoltes = false;
    }
}
